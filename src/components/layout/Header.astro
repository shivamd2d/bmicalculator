---
import { ThemeToggle } from './ThemeToggle';
import { SATELLITE_TOOLS } from '../../constants/bmi';
---

<header class="sticky top-0 z-40 w-full glass-panel border-b border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <img
        src="/logo.png"
        alt="BMI Calculator Pro logo"
        width="36"
        height="36"
        class="w-9 h-9 rounded-2xl group-hover:scale-105 transition-transform shadow-md"
      />
      <div>
        <span class="font-extrabold text-lg tracking-tight text-slate-900 dark:text-white">BMI<span class="text-indigo-600 dark:text-indigo-400">Pro</span></span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-600 dark:text-slate-300">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">BMI Calculator</a>
      
      <!-- Dropdown for Calculators -->
      <div class="relative group py-4">
        <button class="flex items-center gap-1 hover:text-indigo-600 dark:hover:text-indigo-400 transition focus:outline-none">
          <span>All Health Calculators</span>
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full hidden group-hover:grid grid-cols-2 gap-2 w-[480px] p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl animate-in fade-in duration-200">
          {SATELLITE_TOOLS.map((tool) => (
            <a href={tool.href} class="p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-start gap-2.5">
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white">{tool.title}</div>
                <div class="text-[11px] text-slate-500 line-clamp-1">{tool.description}</div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <a href="#faq" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">FAQ</a>
      <a href="/about-us" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">About</a>
      <a href="/contact-us" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Contact</a>
    </nav>

    <!-- Header Right Actions -->
    <div class="flex items-center gap-3">
      <ThemeToggle client:load />
      <a
        href="/"
        class="hidden sm:inline-flex py-2 px-4 rounded-2xl bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-700 text-white font-bold text-xs shadow-md transition"
      >
        Calculate Now
      </a>
    </div>

  </div>
</header>
