---
import MainLayout from '../layouts/MainLayout.astro';
import { CalorieCalculator } from '../components/satellite/CalorieCalculator';
---

<MainLayout
  title="Calorie Calculator - Free Daily TDEE & Calorie Intake Tool"
  description="Calculate your Total Daily Energy Expenditure (TDEE) and exact daily calories required for weight loss, maintenance, or muscle gain using Mifflin-St Jeor formulas."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          Daily <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500">Calorie Calculator</span> (TDEE)
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Determine your Total Daily Energy Expenditure (TDEE) and discover your personalized caloric targets for fat loss, weight maintenance, or muscle growth.
        </p>
      </div>

      <CalorieCalculator client:load />

      <div class="max-w-4xl mx-auto space-y-6 pt-12 border-t border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">What is Total Daily Energy Expenditure (TDEE)?</h2>
        <p>
          Total Daily Energy Expenditure (TDEE) is an estimation of the total number of calories your body burns in a 24-hour period, taking into account your Basal Metabolic Rate (BMR) and daily physical activity level.
        </p>
        
        <h3 class="text-xl font-bold text-slate-900 dark:text-white">How Calories Impact Weight Management</h3>
        <p>
          To lose weight, you must create a <strong>caloric deficit</strong> by consuming fewer calories than your TDEE (typically 300 to 500 kcal per day). To gain muscle mass, a modest <strong>caloric surplus</strong> of 250 to 500 kcal is recommended alongside resistance training.
        </p>
      </div>

    </div>
  </section>
</MainLayout>
