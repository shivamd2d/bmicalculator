---
import MainLayout from '../layouts/MainLayout.astro';
import { BmrCalculator } from '../components/satellite/BmrCalculator';
---

<MainLayout
  title="BMR Calculator - Basal Metabolic Rate Calculator"
  description="Calculate your Basal Metabolic Rate (BMR) - the exact calories your body burns at rest - using Mifflin-St Jeor and Harris-Benedict formulas."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-pink-500">BMR Calculator</span> (Basal Metabolic Rate)
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Find out the minimum number of calories your body burns at complete rest to maintain vital life functions.
        </p>
      </div>

      <BmrCalculator client:load />

      <div class="max-w-4xl mx-auto space-y-6 pt-12 border-t border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">What is Basal Metabolic Rate (BMR)?</h2>
        <p>
          Your Basal Metabolic Rate represents the energy expended while at rest in a neutrally temperate environment. It accounts for 60% to 75% of your total daily energy expenditure.
        </p>
      </div>

    </div>
  </section>
</MainLayout>
