---
import MainLayout from '../layouts/MainLayout.astro';

const faqUrl = `${import.meta.env.BASE_URL}#faq`;
---

<MainLayout
  title="Contact Us - BMI Calculator Pro"
  description="Get in touch with the BMI Calculator Pro team. Send us your questions, feedback, or suggestions. We're happy to help."
>
  <section class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Page Header -->
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300 text-xs font-bold border border-indigo-200 dark:border-indigo-800">
          Get In Touch
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          Contact <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Us</span>
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Have a question, feature request, or found a bug? We'd love to hear from you. Fill in the form below and we'll get back to you as soon as possible.
        </p>
      </div>

      <!-- Contact Info Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm text-center space-y-2">
          <div class="text-2xl">📧</div>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm">Email</h3>
          <p class="text-xs text-slate-500">hello@bmicalculator.app</p>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm text-center space-y-2">
          <div class="text-2xl">⏰</div>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm">Response Time</h3>
          <p class="text-xs text-slate-500">Usually within 24–48 hours on business days</p>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm text-center space-y-2">
          <div class="text-2xl">🌐</div>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm">Based</h3>
          <p class="text-xs text-slate-500">Available worldwide, remote-first team</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="glass-panel rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-xl">
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-6">Send Us a Message</h2>
        <form
          id="contact-form"
          class="space-y-5"
          onsubmit="handleSubmit(event)"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <label for="name" class="text-xs font-bold uppercase text-slate-500 dark:text-slate-400">Your Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" class="text-xs font-bold uppercase text-slate-500 dark:text-slate-400">Email Address *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="subject" class="text-xs font-bold uppercase text-slate-500 dark:text-slate-400">Subject *</label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition"
            >
              <option value="">Select a subject…</option>
              <option value="general">General Question</option>
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="medical">Medical Accuracy Concern</option>
              <option value="partnership">Partnership / Business Inquiry</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="message" class="text-xs font-bold uppercase text-slate-500 dark:text-slate-400">Message *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Describe your question or feedback in detail…"
              class="w-full px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition resize-none"
            ></textarea>
          </div>

          <div id="form-success" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-sm font-semibold">
            ✅ Thank you! Your message has been sent. We'll get back to you within 24–48 hours.
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3.5 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-500/25 transition flex items-center justify-center gap-2"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- FAQ Teaser -->
      <div class="p-6 rounded-2xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between gap-4 flex-wrap">
        <div>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm">Looking for quick answers?</h3>
          <p class="text-xs text-slate-500 mt-1">Check our comprehensive FAQ section with 20+ answered questions about BMI and health metrics.</p>
        </div>
        <a
          href={faqUrl}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-white font-bold text-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition shadow-sm whitespace-nowrap"
        >
          View FAQ →
        </a>
      </div>

    </div>
  </section>

  <script>
    function handleSubmit(event: Event) {
      event.preventDefault();
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const successMsg = document.getElementById('form-success');
      const form = document.getElementById('contact-form') as HTMLFormElement;

      if (btn) btn.textContent = 'Sending…';
      setTimeout(() => {
        if (form) form.reset();
        if (btn) { btn.textContent = 'Message Sent!'; btn.disabled = true; }
        if (successMsg) successMsg.classList.remove('hidden');
      }, 1200);
    }
  </script>
</MainLayout>
