---
import MainLayout from '../layouts/MainLayout.astro';
import { WaistToHeightCalculator } from '../components/satellite/WaistToHeightCalculator';
---

<MainLayout
  title="Waist-to-Height Calculator - Cardiovascular & Visceral Obesity Tool"
  description="Assess your abdominal obesity risk and cardiovascular health score using the Waist-to-Height ratio metric."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-rose-500">Waist-to-Height</span> Calculator
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Calculate your waist-to-height ratio to assess central fat distribution and cardiovascular risk.
        </p>
      </div>

      <WaistToHeightCalculator client:load />

    </div>
  </section>
</MainLayout>
