---
import MainLayout from '../layouts/MainLayout.astro';
import { HealthyWeightCalculator } from '../components/satellite/HealthyWeightCalculator';
---

<MainLayout
  title="Healthy Weight Calculator - Find Your WHO Healthy Weight Range"
  description="Discover the minimum and maximum healthy weight boundaries for your height according to World Health Organization standards."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-green-500">Healthy Weight</span> Range Calculator
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Determine the lower and upper weight limits for a healthy BMI (18.5 – 24.9) based on your height.
        </p>
      </div>

      <HealthyWeightCalculator client:load />

    </div>
  </section>
</MainLayout>
