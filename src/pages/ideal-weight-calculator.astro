---
import MainLayout from '../layouts/MainLayout.astro';
import { IdealWeightCalculator } from '../components/satellite/IdealWeightCalculator';
---

<MainLayout
  title="Ideal Weight Calculator - Compare Clinical IBW Formulas"
  description="Calculate your ideal body weight across Devine, Robinson, Miller, and BMI 22 standard formulas based on your height and gender."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-indigo-500">Ideal Weight Calculator</span> (IBW)
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Compare your ideal weight target across 4 scientifically established clinical formulas.
        </p>
      </div>

      <IdealWeightCalculator client:load />

    </div>
  </section>
</MainLayout>
