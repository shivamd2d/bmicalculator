---
import MainLayout from '../layouts/MainLayout.astro';
import { WaterIntakeCalculator } from '../components/satellite/WaterIntakeCalculator';
---

<MainLayout
  title="Water Intake Calculator - Daily Hydration Requirements"
  description="Calculate your recommended daily water consumption in liters and glasses based on body weight, exercise duration, and climate."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          Daily <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-500 to-blue-500">Water Intake Calculator</span>
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Find your personalized hydration target based on body mass, exercise activity, and climate conditions.
        </p>
      </div>

      <WaterIntakeCalculator client:load />

    </div>
  </section>
</MainLayout>
