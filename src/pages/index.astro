---
import MainLayout from '../layouts/MainLayout.astro';
import { BmiCalculator } from '../components/calculator/BmiCalculator';
import { BMI_CATEGORIES, FAQ_ITEMS, MYTHS_LIST, SATELLITE_TOOLS } from '../constants/bmi';
import { KEYWORD_FAQ_ITEMS } from '../constants/faq-keywords';
const ALL_FAQS = [...FAQ_ITEMS, ...KEYWORD_FAQ_ITEMS];
import { Sparkles, CheckCircle2, ShieldCheck, Flame, Scale, Activity, ArrowRight, HelpCircle, AlertTriangle } from 'lucide-react';
---

<MainLayout
  title="BMI Calculator – Free Body Mass Index Calculator (Metric & Imperial)"
  description="Free BMI Calculator — instantly calculate Body Mass Index, check your weight category, healthy weight range, ideal body weight & personalised health insights. Supports kg & lbs. WHO standards."
  keywords="bmi calculator, calculate bmi, bmi, body mass index, bmi formula, bmi chart, bmi calculator for men, bmi calculator for women, bmi calculator kg, bmi calculator with age, bmi full form, bmi meaning, bmi normal range, normal bmi, what is bmi, bmi index, bmi calculator female, bmi calculator male"
>
  
  {/* HERO & CALCULATOR SECTION */}
  <section class="relative pt-8 pb-16 md:pt-16 md:pb-24 overflow-hidden">
    <!-- Background Glow Accents -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-indigo-500/20 via-purple-500/20 to-pink-500/20 blur-3xl pointer-events-none rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      
      <!-- Hero Headline -->
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-xs font-bold shadow-sm">
          <Sparkles class="w-4 h-4 text-indigo-500" />
          <span>Medical-Grade Precision • WHO Standards</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
          Accurate <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600">BMI Calculator</span> & Health Engine
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
          Instantly determine your Body Mass Index, Ideal Body Weight, Healthy Weight Range, and Ponderal Index. Powered by evidence-based clinical algorithms.
        </p>
      </div>

      <!-- Main Interactive Calculator Island -->
      <div id="calculator-island" class="scroll-mt-24">
        <BmiCalculator client:load />
      </div>

    </div>
  </section>

  {/* BMI CATEGORIES SECTION */}
  <section class="py-16 bg-slate-100/60 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          World Health Organization (WHO) BMI Categories
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Understand how adult Body Mass Index scores are classified into standardized health risk spectrums.
        </p>
      </div>

      <!-- 6 Categories Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {Object.values(BMI_CATEGORIES).map((cat) => (
          <div class={`p-6 rounded-3xl ${cat.bgColor} border ${cat.borderColor} shadow-sm space-y-4 flex flex-col justify-between`}>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class={`px-3 py-1 rounded-full text-xs font-extrabold ${cat.badgeBg}`}>
                  {cat.label}
                </span>
                <span class="text-xs font-black tracking-wider text-slate-500">
                  BMI {cat.rangeText}
                </span>
              </div>

              <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
                {cat.description}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-200/60 dark:border-slate-800/60 space-y-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Key Health Advice</span>
              <ul class="space-y-1 text-xs text-slate-600 dark:text-slate-400">
                {cat.healthAdvice.map((advice) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-indigo-500 font-bold">•</span>
                    <span>{advice}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* HEALTHY WEIGHT & IDEAL WEIGHT FORMULAS SECTION */}
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 text-xs font-bold border border-emerald-200 dark:border-emerald-800">
            <Scale class="w-3.5 h-3.5" />
            <span>Target Weight Analytics</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            How Ideal Body Weight (IBW) is Calculated
          </h2>

          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            While BMI measures current proportional density, clinical medicine relies on specialized Ideal Body Weight formulas developed by researchers to estimate optimal physiological weight baselines.
          </p>

          <div class="space-y-4">
            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">Devine Formula (1974)</h3>
              <p class="text-xs text-slate-500">The gold standard formula used in modern medicine to calculate pharmacokinetic drug dosages and renal clearance clearance rates.</p>
            </div>

            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">BMI 22 Median Standard</h3>
              <p class="text-xs text-slate-500">Determines body weight corresponding to a median healthy BMI score of 22.0, providing a balanced target for adult populations.</p>
            </div>

            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">Robinson & Miller Formulas (1983)</h3>
              <p class="text-xs text-slate-500">Modernized statistical models designed to improve accuracy for height and body proportion variations.</p>
            </div>
          </div>
        </div>

        <!-- Ponderal Index Box Card -->
        <div class="p-8 rounded-3xl bg-gradient-to-br from-indigo-900 via-slate-900 to-purple-950 text-white shadow-2xl space-y-6 relative overflow-hidden">
          <div class="space-y-2">
            <span class="text-xs font-extrabold uppercase tracking-widest text-indigo-300">Advanced Metric</span>
            <h3 class="text-2xl font-black">Understanding Ponderal Index (PI)</h3>
          </div>

          <p class="text-xs text-indigo-100 leading-relaxed">
            The Ponderal Index (also known as the Corpulence Index) measures body mass relative to <strong>height cubed</strong> (<span class="font-mono">kg / m³</span>) rather than height squared.
          </p>

          <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 space-y-2">
            <div class="text-xs font-bold text-indigo-200">Why use Ponderal Index?</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Standard BMI tends to exaggerate fatness in tall individuals and underestimate fatness in shorter individuals. Ponderal Index provides a more consistent volumetric ratio across height extremes.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs pt-2">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <div class="text-[10px] text-indigo-300 font-bold uppercase">Normal PI Range</div>
              <div class="text-lg font-black text-white mt-0.5">11.0 – 15.0 <span class="text-xs font-normal">kg/m³</span></div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <div class="text-[10px] text-indigo-300 font-bold uppercase">Formula</div>
              <div class="text-lg font-black text-white mt-0.5">Weight ÷ Height³</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* MYTHS VS FACTS SECTION */}
  <section class="py-16 bg-slate-100/60 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Common BMI Myths & Facts
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Debunking widespread misconceptions surrounding Body Mass Index and health screening.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {MYTHS_LIST.map((item) => (
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-2 text-rose-600 dark:text-rose-400 text-xs font-bold">
              <AlertTriangle class="w-4 h-4" />
              <span>{item.myth}</span>
            </div>
            <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">
              {item.fact}
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              {item.explanation}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* RELATED SATELLITE TOOLS SHOWCASE */}
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Explore Our Suite of Health Calculators
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Comprehensive, evidence-based fitness and body composition tools designed for accuracy.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {SATELLITE_TOOLS.map((tool) => (
          <a
            href={tool.href}
            class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group flex flex-col justify-between space-y-4"
          >
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold">
                <Activity class="w-5 h-5" />
              </div>
              <h3 class="font-extrabold text-slate-900 dark:text-white text-base group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                {tool.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {tool.description}
              </p>
            </div>

            <div class="flex items-center gap-1.5 text-xs font-bold text-indigo-600 dark:text-indigo-400">
              <span>Try Calculator</span>
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  {/* 20+ FAQ ACCORDION SECTION */}
  <section id="faq" class="py-16 bg-slate-100/60 dark:bg-slate-900/40 border-t border-slate-200/80 dark:border-slate-800/80 scroll-mt-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300 text-xs font-bold">
          <HelpCircle class="w-4 h-4" />
          <span>Frequently Asked Questions</span>
        </div>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Everything You Need to Know About BMI
        </h2>
      </div>

      <!-- Accordion Grid -->
      <div class="space-y-4">
        {ALL_FAQS.map((faq, index) => (
          <details class="group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 cursor-pointer shadow-sm transition [&[open]]:shadow-md">
            <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 dark:text-white list-none select-none">
              <span>{index + 1}. {faq.question}</span>
              <span class="ml-4 transition-transform group-open:rotate-180 text-indigo-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/60 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  {/* ── SEO ARTICLE SECTION ─────────────────────────────────────────────── */}
  <section class="py-16 bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="prose prose-slate dark:prose-invert max-w-none text-sm leading-relaxed space-y-5 text-slate-700 dark:text-slate-300">

        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">BMI Calculator: The Complete Guide to Understanding Body Mass Index</h2>

        <p>A <strong>BMI calculator</strong> is one of the most widely used tools in preventive healthcare. Body Mass Index — commonly written as <strong>BMI</strong> — is a simple numerical value derived from your height and weight that gives clinicians and individuals a quick snapshot of where body weight sits relative to height. Whether you are tracking weight loss progress, assessing cardiovascular risk, or simply curious about what the <strong>BMI formula</strong> means, understanding BMI is the first step toward informed health decisions.</p>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">What Is BMI and What Does It Stand For?</h3>
        <p>The <strong>full form of BMI</strong> is <strong>Body Mass Index</strong>. The BMI index was developed by Belgian mathematician Adolphe Quetelet in the 19th century and was later popularised in clinical research by physiologist Ancel Keys in 1972. Today it is endorsed by the World Health Organization (WHO), the Centers for Disease Control and Prevention (CDC), and most national health bodies globally as a first-line screening tool for weight-related health risk.</p>
        <p><strong>BMI meaning</strong> in plain language: it tells you whether your weight is proportional to your height. A person with a <strong>normal BMI</strong> — that is, a score between 18.5 and 24.9 — statistically carries a lower risk of developing conditions such as Type 2 diabetes, cardiovascular disease, sleep apnea, and certain cancers compared to individuals in overweight or obese categories.</p>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">How to Calculate BMI: The Formula Explained</h3>
        <p>The standard <strong>BMI formula</strong> is straightforward. In the metric system: <strong>BMI = weight (kg) &divide; height&sup2; (m&sup2;)</strong>. In the imperial system used in the United States: <strong>BMI = [weight (lbs) &divide; height&sup2; (inches&sup2;)] &times; 703</strong>.</p>
        <p>For example, if you weigh 75 kg and stand 1.75 m tall, your BMI = 75 &divide; (1.75 &times; 1.75) = 75 &divide; 3.0625 = 24.5 — which places you comfortably in the <strong>Normal Weight</strong> category. Our free <strong>BMI calculator in kg</strong> above handles this calculation instantly, supporting both metric and imperial inputs and returning your full result within seconds.</p>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">BMI Chart: Understanding the Categories</h3>
        <p>The WHO <strong>BMI chart</strong> divides adult body weight into four primary categories based on BMI score:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>Underweight</strong>: BMI below 18.5 — may indicate malnutrition, excessive leanness, or an underlying medical condition.</li>
          <li><strong>Normal Weight</strong>: BMI 18.5 to 24.9 — the healthy range associated with lowest chronic disease risk. A BMI of 20 to 22 is considered optimal for longevity.</li>
          <li><strong>Overweight</strong>: BMI 25 to 29.9 — excess weight relative to height; carries elevated risk of metabolic conditions.</li>
          <li><strong>Obese (Class I, II, III)</strong>: BMI 30 and above — significantly elevated risk of cardiovascular disease, diabetes, joint problems, and reduced life expectancy.</li>
        </ul>
        <p>The <strong>normal BMI range</strong> of 18.5 to 24.9 is used universally for adult men and women aged 20 and above. For Asian populations, many health authorities recommend a lower Overweight threshold of 23.0 due to differences in how visceral fat accumulates at equivalent BMI levels.</p>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">BMI Calculator for Men vs. BMI Calculator for Women</h3>
        <p>The mathematical formula is identical for both sexes, but body composition differs significantly between men and women. A <strong>BMI calculator for men</strong> applies the same equation — weight divided by height squared — but results are interpreted with the knowledge that men naturally carry more skeletal muscle mass. This means a muscular man may register in the Overweight category despite having very low body fat. For highly active men or athletes, combining BMI with body fat percentage or waist circumference measurement provides a more accurate health picture.</p>
        <p>A <strong>BMI calculator for women</strong> or <strong>BMI calculator female</strong> works the same way, but women physiologically carry higher essential body fat (approximately 20 to 35 percent in the healthy range) compared to men (8 to 19 percent) at equivalent BMI scores. Postmenopausal women and pregnant women should interpret BMI alongside additional clinical markers rather than relying on it as a standalone indicator.</p>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">BMI Calculator with Age and Kg</h3>
        <p>Our <strong>BMI calculator with age</strong> takes your age into account when generating personalised health insights. While BMI thresholds remain constant across adulthood, age affects body composition interpretation: older adults, particularly those over 65, may benefit from a slightly higher BMI of 23 to 27 as a protective buffer against frailty, sarcopenia (muscle loss), and osteoporosis. Entering your age ensures the insights you receive are calibrated appropriately to your life stage.</p>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">Why Use Our BMI Calculator?</h3>
        <p>Unlike basic BMI calculators that show only a score, <strong>BMI Calculator Pro</strong> provides a complete health analysis suite — entirely free, with no registration required, and no data ever leaving your browser. Here is what you get in one click:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Your BMI score and WHO weight category with a visual animated gauge</li>
          <li>Healthy weight range for your height</li>
          <li>Ideal body weight using four clinical formulas: Devine (1974), Robinson (1983), Miller (1983), and BMI-22 Standard</li>
          <li>Ponderal Index (an alternative leanness metric)</li>
          <li>Personalised health advice, risk factors, and actionable recommendations</li>
          <li>Saved calculation history stored locally in your browser</li>
          <li>Eight additional health calculators: Calorie (TDEE), BMR, Body Fat Percentage, Protein Intake, Water Intake, Ideal Weight, Healthy Weight, and Waist-to-Height Ratio</li>
        </ul>

        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">Limitations of BMI</h3>
        <p>While BMI is a validated, evidence-based screening tool, it has well-documented limitations. It does not directly measure body fat — it uses weight and height as proxies. Athletes with high muscle mass may be misclassified as Overweight. It does not distinguish between subcutaneous fat (under the skin) and visceral fat (around organs), which has more direct metabolic consequences. For the most comprehensive health assessment, use BMI alongside waist circumference, body fat percentage, blood pressure, fasting glucose, and lipid profiles.</p>
        <p>BMI Calculator Pro is designed to be informational and educational. Results should always be discussed with a qualified healthcare professional before making clinical decisions.</p>

      </article>
    </div>
  </section>

</MainLayout>
