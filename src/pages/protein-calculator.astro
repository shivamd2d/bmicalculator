---
import MainLayout from '../layouts/MainLayout.astro';
import { ProteinCalculator } from '../components/satellite/ProteinCalculator';
---

<MainLayout
  title="Protein Calculator - Daily Protein Intake Tool"
  description="Calculate your optimal daily protein requirements for muscle hypertrophy, athletic recovery, or fat loss based on body mass and activity."
>
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          Daily <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-500">Protein Calculator</span>
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Determine your optimal daily protein target in grams for strength building, fat loss, or athletic maintenance.
        </p>
      </div>

      <ProteinCalculator client:load />

    </div>
  </section>
</MainLayout>
