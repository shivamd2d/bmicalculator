---
import MainLayout from '../layouts/MainLayout.astro';
import { ShieldCheck, Sparkles, Target, Users } from 'lucide-react';
---

<MainLayout
  title="About Us - BMI Calculator Pro"
  description="Learn about BMI Calculator Pro — our mission, the team behind the project, and why we built the most accurate, privacy-first BMI calculator on the web."
>
  <section class="py-12 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-300 text-xs font-bold border border-indigo-200 dark:border-indigo-800">
          Our Story
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          About <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">BMI Calculator Pro</span>
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          We built the most accurate, accessible, and privacy-first Body Mass Index calculator on the internet — and we're not stopping there.
        </p>
      </div>

      <!-- Mission Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-7 rounded-3xl bg-gradient-to-br from-indigo-600 to-purple-700 text-white shadow-xl space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center">
            <Target class="w-5 h-5 text-white" />
          </div>
          <h2 class="text-xl font-extrabold">Our Mission</h2>
          <p class="text-sm text-indigo-100 leading-relaxed">
            To democratize access to medical-grade health analytics. Everyone deserves clear, evidence-based health insights — without subscriptions, ads, or data harvesting.
          </p>
        </div>

        <div class="p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 flex items-center justify-center">
            <ShieldCheck class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
          </div>
          <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Privacy First</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Zero data collection. All calculations happen entirely in your browser. Your health data never leaves your device. No account required. No tracking.
          </p>
        </div>
      </div>

      <!-- What We Offer -->
      <div class="space-y-8">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">What We Offer</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400">A complete suite of evidence-based health calculators built on clinical research.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {[
            { title: 'Clinical Accuracy', text: 'Formulas sourced from peer-reviewed medical research — Devine (1974), Robinson (1983), Mifflin-St Jeor, US Navy, WHO standards.' },
            { title: 'Instant Results', text: 'Real-time calculations with animated visual feedback. No page reloads, no waiting — results update as you type.' },
            { title: '9 Health Tools', text: 'BMI, Calorie, BMR, Body Fat, Protein, Water Intake, Ideal Weight, Healthy Weight, and Waist-to-Height calculators.' },
          ].map(item => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
              <div class="w-2 h-2 rounded-full bg-indigo-500"></div>
              <h3 class="font-extrabold text-slate-900 dark:text-white text-sm">{item.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Values -->
      <div class="p-8 rounded-3xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-5">
        <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">Our Core Values</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-700 dark:text-slate-300">
          {[
            '🔬 Evidence-based science over wellness trends',
            '🔒 Privacy-by-design — no data leaves your browser',
            '♿ Accessible to everyone — WCAG AA compliant',
            '⚡ Performance-first — zero unnecessary JavaScript',
            '🌍 Free forever — no paywalls or premium tiers',
            '📚 Educational content that empowers informed decisions',
          ].map(val => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5">{val}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div class="text-center space-y-4">
        <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">Have Questions or Feedback?</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">We'd love to hear from you. Reach out through our contact page.</p>
        <a
          href="/contact-us"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-500/25 transition"
        >
          Get in Touch
        </a>
      </div>

    </div>
  </section>
</MainLayout>
